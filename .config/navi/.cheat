% nix

# Update nix pkgs
sudo darwin-rebuild switch --flake $HOME/dotfiles/.config/nix#$USER

# Install nix darwin
nix run nix-darwin/master#darwin-rebuild -- switch --flake $HOME/dotfiles/.config/nix#$USER


# update nix
nix flake  update nix-darwin --flake $HOME/dotfiles/.config/nix


% dotfiles

# Adopt stow adopt
cd $HOME/dotfiles && stow . --adopt && cd -


% nvim 

# Sync nvim lua to dotfiles
cp -r ~/.config/nvim/lua ~/dotfiles/.config/nvim


% firebase(tourstory)



# firestore backup 


gcloud firestore export <base_url>/manual-backup/<date> --collection-ids=<collection-ids> --project <project_id> 

$ project_id: echo "kint-2"
$ base_url: echo "gs://kint-2.appspot.com"

# download
gsutil -m cp -r gs://kint-2.appspot.com/manual-backups/<date> <path>




