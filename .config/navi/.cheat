% nix

# Update nix pkgs
darwin-rebuild switch --flake $HOME/dotfiles/.config/nix#$USER

# Install nix darwin
nix run nix-darwin/master#darwin-rebuild -- switch --flake ~/dotfiles/.config/nix


% dotfiles

# Adopt stow
cd $HOME/dotfiles && stow . --adopt && cd -


% ollama

# Run llama3.2 inline
ollama run llama3.2 "<text>"


% nvim 

# Sync nvim lua to dotfiles
cp -r ~/.config/nvim/lua ~/dotfiles/.config/nvim


% quartz

# Serve 

npx quartz build --serve


# Upload

npx quartz sync


% docker

# Run(interactive)

docker run -it <container-id> <shell>


# Build

docker build <path-to-dockerfile>

# List Images

docker images


# List Running Containers

docker ps

# List All Containers

docker ps -a


# Start

docker start <container-id>

# Connect

docker exec -it <container-id> <shell>

# Remove Image

docker rmi <image-id>

# Remove Container
docker rm <container-id>
