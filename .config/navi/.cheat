% nix

# Update nix pkgs
sudo darwin-rebuild switch --flake $HOME/dotfiles/.config/nix#$USER

# Install nix darwin
nix run nix-darwin/master#darwin-rebuild -- switch --flake $HOME/dotfiles/.config/nix#$USER


# update nix
nix flake  update nix-darwin --flake $HOME/dotfiles/.config/nix


% dotfiles

# Adopt stow adopt
cd $HOME/dotfiles && stow . --adopt && cd -


% ollama

# Run llama3.2 inline
ollama run llama3.2 "<text>"


% nvim 

# Sync nvim lua to dotfiles
cp -r ~/.config/nvim/lua ~/dotfiles/.config/nvim


% quartz

# Serve 

npx quartz build --serve


# Upload

npx quartz sync


