theme = onedark_dark 

macos-option-as-alt = true
keybind = cmd+a=unbind

background = #000
background-opacity = 0.7
background-blur = true

font-family = Dank Mono Nerd
font-family = 나눔스퀘어라운드

bold-is-bright = true

auto-update = download




quick-terminal-position = center
quick-terminal-screen = main
quick-terminal-animation-duration = 0.2
quick-terminal-size = 90%,90%

keybind = ctrl+t>t=toggle_quick_terminal

keybind = ctrl+t>x=close_surface

keybind = ctrl+t>w>l=resize_split:right,100
keybind = ctrl+t>w>h=resize_split:left,100
keybind = ctrl+t>w>j=resize_split:down,100
keybind = ctrl+t>w>u=resize_split:up,100

keybind = ctrl+t>s>l=new_split:right
keybind = ctrl+t>s>h=new_split:left
keybind = ctrl+t>s>j=new_split:down
keybind = ctrl+t>s>j=new_split:down
keybind = ctrl+t>s>e=equalize_splits

keybind = ctrl+t>l=goto_split:right
keybind = ctrl+t>h=goto_split:left
keybind = ctrl+t>j=goto_split:down
keybind = ctrl+t>k=goto_split:up

keybind = ctrl+t>g>one=goto_tab:1
keybind = ctrl+t>g>two=goto_tab:2
keybind = ctrl+t>g>three=goto_tab:3
keybind = ctrl+t>g>four=goto_tab:4
keybind = ctrl+t>g>five=goto_tab:5

keybind = ctrl+t>c=new_tab
keybind = ctrl+t>p=previous_tab
keybind = ctrl+t>n=next_tab

keybind = ctrl+t>f>i=increase_font_size:0.5
keybind = ctrl+t>f>d=decrease_font_size:0.5

keybind = ctrl+t>i=inspector:toggle


keybind = ctrl+t>u=scroll_page_up
keybind = ctrl+t>d=scroll_page_down

keybind = cmd+enter=toggle_fullscreen

keybind = ctrl+t>r=reload_config

keybind = shift+enter=text:\n




